flowchart LR
    %% One customer order; original-delivery scoring and redelivery are separate workflows.

    Staff["Retailer, warehouse and carrier staff"]
    APIs["Weather, travel and holiday APIs"]
    Planner["Regional planning staff"]
    Rep["Customer representative"]
    Team["Assigned order management team"]

    subgraph System["Delivery Risk Agent MVP - system boundary"]
        Evidence["Order and delivery evidence"]
        Risk["Risk queue: High first, handled last"]
        Redelivery["Claims and same-order redelivery"]

        Evidence -->|"time-safe facts; new evidence triggers rescore"| Risk
        Evidence -->|"handover and replacement evidence"| Redelivery
        Redelivery -->|"approval stops original scoring"| Evidence
    end

    Staff -->|"orders, promises and delivery events"| Evidence
    APIs -->|"timestamped observations"| Evidence

    Risk -->|"ranked orders and recommendations"| Planner
    Planner -->|"review and mark High-risk episode handled"| Risk

    Redelivery -->|"claim details"| Rep
    Rep -->|"inspection and replacement approval"| Redelivery
    Redelivery -->|"urgent task and issues; High until accepted"| Team

    classDef external fill:#f5f7fa,stroke:#64748b,color:#111827
    classDef internal fill:#e8f1ff,stroke:#2563eb,color:#111827
    class Staff,APIs,Planner,Rep,Team external
    class Evidence,Risk,Redelivery internal
    style System fill:#eff6ff,stroke:#1d4ed8,stroke-width:2px
